{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": "apps/web/.next",
  "crons": [
    {
      "path": "/api/cron/sheets-sync",
      "schedule": "20 0 * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "40 0 * * *"
    }
  ]
}
