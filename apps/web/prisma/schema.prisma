// Routely data model.
//
// Two rules govern this schema:
//
//  1. Every metric has exactly one source of truth. Visitor counts come from Assignment,
//     page views and engagement from Event, conversions from Conversion. Nothing is
//     denormalised into a counter column that could drift from the rows it summarises.
//
//  2. Aggregation never needs a join. Rows that the dashboard groups by variant carry
//     `variantId` (and `websiteId` where useful) directly, so every dashboard query is served
//     by a covering index on the table it reads.
//
// Ownership flows Workspace → Website → Experiment → (Assignment | Event | Conversion), and every
// cascade follows that chain, so deleting a website removes its entire tree. Users reach a
// workspace only through a Membership, whose role decides what they may change.
//
// An experiment has one control (`Experiment.controlUrl` — the page visitors already land on,
// never redirected) and one or more variants (`ExperimentVariant` rows — a redirect target for a
// SPLIT_URL test, a set of DOM changes for an AB_TEST).
// `variantId` on Assignment/Event/Conversion is nullable: NULL means control. Control isn't a
// row in `ExperimentVariant` because it isn't a redirect target — giving it one would duplicate
// `controlUrl` as a second source of truth for the same fact.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // Loads an `include`/`select` of relations in one SQL statement (LATERAL joins) instead of one
  // query per relation level. The access filters read experiment → website → workspace →
  // membership, which is four sequential round trips without it. See docs/DEPLOY-VERCEL.md §8.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentication — shapes required by the Auth.js Prisma adapter (Part 2).
// Field names and types are fixed by the adapter and must not be renamed.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// `scrypt$N$r$p$salt$hash`. Null for an account that has only ever signed in with Google.
  passwordHash      String?
  passwordChangedAt DateTime?

  /// The workspace the dashboard shows. Not a foreign key on purpose: a membership can be removed
  /// while this still points at it, so the session seam re-checks membership on every request and
  /// falls back to the oldest one. Null until the first workspace exists.
  currentWorkspaceId String?

  /// Set when the account is disabled. Sign-in refuses a disabled account.
  disabledAt DateTime?

  accounts           Account[]
  sessions           Session[]
  memberships        Membership[]
  invitesSent        WorkspaceInvite[]        @relation("InvitesSent")
  emailChanges       EmailChangeRequest[]
  passwordResets     PasswordResetToken[]
  verificationCodes  EmailVerificationCode[]
  notificationPrefs  NotificationPreference[]
  knownDevices       KnownSignInDevice[]
  websitesCreated    Website[]                @relation("WebsiteCreatedBy")
  experimentsCreated Experiment[]             @relation("ExperimentCreatedBy")
  winnersChosen      Experiment[]             @relation("ExperimentWinnerChosenBy")
  activities         ExperimentActivity[]
  sheetsConnected    SheetsConnection[]       @relation("SheetsConnectedBy")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  // Extra columns for "Where you're signed in". The Auth.js adapter ignores columns it does not
  // know about, so these never interfere with its own reads and writes.
  createdAt  DateTime @default(now())
  /// Last request seen on this session. Bumped by a throttled compare-and-set, never per request.
  lastSeenAt DateTime @default(now())
  userAgent  String?
  city       String?
  /// ISO 3166-1 alpha-2.
  country    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Account — tokens and preferences. Every token is 32 random bytes; only its SHA-256 is stored.
// ---------------------------------------------------------------------------

/// A pending change of the sign-in address. Takes effect only when the link sent to the new
/// address is followed.
model EmailChangeRequest {
  id         String    @id @default(cuid())
  userId     String
  newEmail   String
  tokenHash  String    @unique
  /// createdAt + 24 h.
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_change_requests")
}

/// The six-digit code in "Verify your email", typed on `/verify-email` — the other way to verify
/// besides the link. One live code per user; issuing a new one replaces it. Only a hash is stored,
/// and every guess spends one of `attempts` *before* it is compared, so concurrent guesses cannot
/// exceed the limit. A million possible codes against five guesses is the security margin.
model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  /// SHA-256 of `<userId>:<code>`.
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_codes")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  /// createdAt + 1 h.
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// An explicit opt-in or opt-out. No row means the kind's default applies.
model NotificationPreference {
  userId    String
  kind      NotificationKind
  enabled   Boolean
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
  @@map("notification_preferences")
}

/// A (browser, OS, country) combination this user has signed in from before. Drives the
/// "New sign-in to Routely" email.
model KnownSignInDevice {
  userId          String
  /// sha256(browser | os | country).
  fingerprintHash String
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, fingerprintHash])
  @@map("known_sign_in_devices")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Lifecycle of an experiment. Only ACTIVE experiments are published to the SDK. COMPLETED is
/// terminal (renamed from ARCHIVED in place, so existing rows kept their meaning).
enum ExperimentStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

/// SPLIT_URL redirects each variant to its own URL; AB_TEST applies DOM changes on the same URL.
enum ExperimentType {
  SPLIT_URL
  AB_TEST
}

/// Device classes a test can be limited to. An empty list means every device.
enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
}

/// A member's role in a workspace, in descending order of power. `lib/permissions.ts` holds the
/// matrix of what each may do.
enum MemberRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum ExperimentActivityType {
  CREATED
  LAUNCHED
  PAUSED
  RESUMED
  ENDED
  EDITED
  RESULT_READY
  WINNER_CHOSEN
}

enum WinnerBasis {
  RECOMMENDED
  MANUAL
}

/// Opt-out-able emails. Security emails are not listed because they cannot be turned off.
enum NotificationKind {
  RESULT_READY
  TRACKING_STOPPED
  SHEETS_SYNC_FAILED
  EXPERIMENT_PAUSED
}

enum TrackingCheckResult {
  OK
  MISSING
  ERROR
}

/// How a configured URL is compared against the visitor's current URL.
enum UrlMatchType {
  EXACT
  PREFIX
}

/// Scheme a website is served over.
enum SiteProtocol {
  HTTPS
  HTTP
}

/// Which measurement the results page highlights as "currently ahead" for an experiment.
enum PrimaryMetric {
  CONVERSION_RATE
  TIME_ON_PAGE
  PAGE_VIEWS
}

/// Event taxonomy. Values are the literal strings the SDK sends on the wire, so the
/// ingestion endpoint stores what it receives without a translation table.
enum EventType {
  page_view
  assignment
  time_on_page
  conversion
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// The tenant. Every website belongs to exactly one workspace, and users reach it only through a
/// Membership. Every new user gets one of their own ("{First}'s workspace") as its OWNER.
model Workspace {
  id        String   @id @default(cuid())
  /// "{First}’s workspace" by default; at most 80 characters (enforced in Zod).
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      Membership[]
  invites          WorkspaceInvite[]
  websites         Website[]
  sheetsConnection SheetsConnection?

  @@map("workspaces")
}

/// A user's place in a workspace. Exactly one OWNER per workspace, enforced by the partial unique
/// index `memberships_one_owner` (hand-written in the migration — Prisma cannot express it).
model Membership {
  id           String     @id @default(cuid())
  workspaceId  String
  userId       String
  role         MemberRole
  /// "Last active" on the Team tab. Bumped by a throttled compare-and-set.
  lastActiveAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

/// An emailed invitation. At most one *pending* invite per (workspace, email), enforced by the
/// partial unique index `workspace_invites_pending` (hand-written in the migration).
model WorkspaceInvite {
  id           String     @id @default(cuid())
  workspaceId  String
  /// Lowercased.
  email        String
  /// Never OWNER — ownership is not granted by invitation (a service rule).
  role         MemberRole
  tokenHash    String     @unique
  invitedById  String?
  sentAt       DateTime   @default(now())
  /// sentAt + 7 days.
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([email])
  @@map("workspace_invites")
}

/// A customer property. Owns experiments and visitors, and carries the public site id embedded
/// in the tracking snippet.
model Website {
  id                  String       @id @default(cuid())
  /// The tenant key. Replaced `userId`; existing rows were moved into their owner's workspace.
  workspaceId         String
  /// Who added it. Display only — never an authorization input.
  createdById         String?
  name                String
  /// Primary domain, e.g. "acme.com". Used for the Origin soft-check on ingestion.
  domain              String
  /// Scheme this site is served over. Stored because `domain` is a bare hostname, so nothing
  /// else records whether the site is http or https — and every URL the UI prefills (the
  /// install check, experiment URL placeholders) has to guess otherwise. Defaults to https,
  /// which is right for everything except local development.
  protocol            SiteProtocol @default(HTTPS)
  /// Public identifier embedded in the install snippet ("rt_…"). An identifier, not a secret:
  /// it is visible in page source by design and grants no access beyond appending events.
  publicSiteId        String       @unique
  /// When the snippet was last confirmed present on a page of this website, by fetching that
  /// page and finding the site id in its HTML. Null until the install check has passed once.
  ///
  /// Deliberately the timestamp of an *observation*, not a boolean "is installed": a customer
  /// can remove the snippet at any time and nothing tells us, so this records when we last
  /// looked and what we saw, which is all it can honestly claim.
  pixelVerifiedAt     DateTime?
  /// Avatar palette slot, 0–4.
  colorIndex          Int          @default(0)
  /// Last site-wide SDK hit, bumped by a throttled compare-and-set. A freshness timestamp, not a
  /// metric — tracking status is derived from it.
  lastSeenAt          DateTime?
  /// Latch for the "Tracking stops" email, so it is sent once per outage.
  trackingAlertSentAt DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User?               @relation("WebsiteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  experiments    Experiment[]
  visitors       Visitor[]
  events         Event[]
  visitorDays    WebsiteVisitorDay[]
  pageDays       PageVisitorDay[]
  trackingChecks TrackingCheck[]

  /// At most one Google Sheets destination per website.
  sheetTarget WebsiteSheetTarget?

  // One project per domain within a workspace. Names are unique case-insensitively too, through
  // the expression index `websites_ws_name_ci` (hand-written in the migration).
  @@unique([workspaceId, domain])
  // Dashboard lists a workspace's websites newest-first.
  @@index([workspaceId, createdAt])
  @@map("websites")
}

/// One row per website × UTC day × browser that loaded any page carrying the snippet. Rows, not a
/// counter: a daily visitor count is `count(*)` and cannot drift from what was recorded.
model WebsiteVisitorDay {
  websiteId   String
  day         DateTime @db.Date
  /// The SDK's anonymous id. Deliberately not a foreign key: Visitor rows exist only for
  /// experiment participants, and a site-wide hit must not create one.
  anonymousId String

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@id([websiteId, day, anonymousId])
  @@map("website_visitor_days")
}

/// Per-page daily visitors: the traffic baseline for a URL, and the "seen" fallback for tracking
/// checks on sites that inject the snippet through a tag manager.
model PageVisitorDay {
  websiteId   String
  /// Server-normalised URL.
  urlKey      String
  day         DateTime @db.Date
  anonymousId String

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@id([websiteId, urlKey, day, anonymousId])
  @@index([websiteId, urlKey, day])
  @@map("page_visitor_days")
}

/// The last snippet check for one URL of a website. Changing a URL changes its key, so a stale
/// check can never vouch for a page it did not look at.
model TrackingCheck {
  id         String              @id @default(cuid())
  websiteId  String
  urlKey     String
  result     TrackingCheckResult
  /// "html" (the snippet was in the page) or "seen" (the page reported hits recently).
  method     String?
  pageLoaded Boolean             @default(false)
  httpStatus Int?
  detail     String?
  checkedAt  DateTime            @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, urlKey])
  @@map("tracking_checks")
}

// ---------------------------------------------------------------------------
// Experiments
// ---------------------------------------------------------------------------

/// A redirect test: visitors on `controlUrl` are divided between staying put and being sent to
/// one of `variants`, in the proportions given by `controlWeight` and each variant's `weight`;
/// reaching `conversionUrl` counts as a conversion.
model Experiment {
  id          String         @id @default(cuid())
  websiteId   String
  type        ExperimentType @default(SPLIT_URL)
  /// May be empty while DRAFT; required at launch.
  name        String         @default("")
  description String?

  /// Null only while DRAFT — launch requires it, and the config and ingestion paths only read
  /// ACTIVE rows (and skip any that lack it).
  controlUrl       String?
  controlMatchType UrlMatchType @default(EXACT)

  /// Label for the conversion goal, shown on the Metrics list. Nullable because every
  /// experiment created before goals were nameable has one and needs no backfill — the UI
  /// falls back to the experiment's own name.
  conversionName      String?
  /// Null only while DRAFT, like `controlUrl`.
  conversionUrl       String?
  conversionMatchType UrlMatchType @default(EXACT)

  /// Control's share of the traffic entered into this experiment, relative to each variant's
  /// `weight`. Weights are **relative**, normalised at draw time — so they carry no redundancy
  /// with `trafficAllocation`, which independently decides how many visitors are entered at
  /// all. A visitor's odds of landing on control are
  /// `controlWeight / (controlWeight + sum(variant weights))`.
  controlWeight Int @default(50)

  status ExperimentStatus @default(DRAFT)

  /// Percentage of visitors on the control page entered into this experiment at all, 1–100.
  /// The remaining share see the control page untouched — never assigned, redirected or
  /// tracked for this experiment. Independent of `variantSplit`, which only decides the arm
  /// for visitors already included, so narrowing this cannot skew the comparison between arms.
  trafficAllocation Int @default(100)

  /// Which measurement the results page highlights as "currently ahead". Every metric is
  /// always collected regardless of this choice — it only changes what is emphasised.
  primaryMetric PrimaryMetric @default(CONVERSION_RATE)

  /// Devices the test is limited to. Empty means every device; all three is normalised to empty.
  /// Decided by the SDK in the browser — the server cannot verify it.
  targetDevices   DeviceType[] @default([])
  /// SPLIT_URL: carry the visitor's query string over to the variant URL.
  keepQueryParams Boolean      @default(true)
  /// The wizard step (1–5) a draft resumes at.
  wizardStep      Int          @default(1)
  createdById     String?

  /// Unguessable token for the public, read-only results page. Null when sharing is off, so
  /// revoking a link is a matter of clearing it rather than maintaining a separate flag.
  shareToken String?   @unique
  sharedAt   DateTime?

  publishedAt   DateTime?
  /// The most recent pause.
  pausedAt      DateTime?
  /// When it was ended (status COMPLETED). Renamed from `stoppedAt`.
  endedAt       DateTime?
  /// Latch for the RESULT_READY activity and email, so each fires once.
  resultReadyAt DateTime?

  /// The version the team decided to keep, chosen when ending the experiment or afterwards.
  /// Decided ⇔ `winnerChosenAt` is set; then a null `winnerVariantId` means Control. Routely does
  /// not serve the winner — the customer updates their own site (`lib/verdict.ts`).
  winnerChosenAt   DateTime?
  winnerVariantId  String?
  /// Whether the choice was Routely's gated recommendation or the team's own call, worked out on the
  /// server from the frozen results when it was made.
  winnerBasis      WinnerBasis?
  winnerChosenById String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  website        Website              @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  createdBy      User?                @relation("ExperimentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  // Variants of a launched experiment are never deleted, so SetNull (which would read as Control)
  // only ever fires while the experiment itself is being deleted.
  winnerVariant  ExperimentVariant?   @relation("ExperimentWinner", fields: [winnerVariantId], references: [id], onDelete: SetNull)
  winnerChosenBy User?                @relation("ExperimentWinnerChosenBy", fields: [winnerChosenById], references: [id], onDelete: SetNull)
  variants       ExperimentVariant[]
  assignments    Assignment[]
  events         Event[]
  conversions    Conversion[]
  activities     ExperimentActivity[]

  // Serves the SDK config endpoint: "active experiments for this website".
  @@index([websiteId, status])
  // Serves the website detail page: experiments newest-first.
  @@index([websiteId, createdAt])
  @@map("experiments")
}

/// One redirect target for an experiment. The control arm is deliberately not a row here — see
/// the note at the top of this file.
model ExperimentVariant {
  id           String  @id @default(cuid())
  experimentId String
  /// Display and redirect-draw order: 1, 2, 3…
  position     Int
  /// Display name, "Variant A"–"Variant D" by default (editable for SPLIT_URL). Existing rows were
  /// backfilled from their position.
  name         String
  /// Colour slot 1–4, the first unused one when the variant was added; stable across removals.
  colorIndex   Int     @default(1)
  /// SPLIT_URL: the redirect target. AB_TEST: null. Also null while a SPLIT_URL draft is unfinished.
  url          String?
  /// AB_TEST: the DOM changes (`VisualChange[]`, validated by Zod with a schemaVersion). Null for
  /// SPLIT_URL.
  changes      Json?
  /// This arm's share of the traffic entered into the experiment, relative to `controlWeight`
  /// and the other variants' weights. See `Experiment.controlWeight`. `0` parks an arm without
  /// deleting it — it keeps its collected results but stops receiving new visitors.
  weight       Int     @default(50)

  experiment  Experiment   @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  events      Event[]
  conversions Conversion[]
  wonIn       Experiment[] @relation("ExperimentWinner")

  @@index([experimentId, position])
  @@map("experiment_variants")
}

/// The experiment's history, written in the same transaction as the change it records. One
/// RESULT_READY per experiment, enforced by the partial unique index
/// `experiment_activities_result_once` (hand-written in the migration).
model ExperimentActivity {
  id           String                 @id @default(cuid())
  experimentId String
  type         ExperimentActivityType
  /// Null for system entries, and once the acting user has been deleted.
  actorId      String?
  meta         Json?
  createdAt    DateTime               @default(now())

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  actor      User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([experimentId, createdAt])
  @@map("experiment_activities")
}

// ---------------------------------------------------------------------------
// Tracking
// ---------------------------------------------------------------------------

/// A browser, identified by the opaque id the SDK stores in the visitor's own storage.
/// Scoped to a website because the SDK mints one id per installed snippet, and because it
/// keeps one customer's identifiers from colliding with another's.
model Visitor {
  id          String   @id @default(cuid())
  websiteId   String
  /// Client-generated UUID from the SDK. Never a user identifier and never PII.
  anonymousId String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  website     Website      @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  events      Event[]
  conversions Conversion[]

  /// Identity resolution on every ingested batch: one row per browser per website.
  @@unique([websiteId, anonymousId])
  @@index([websiteId, lastSeenAt])
  @@map("visitors")
}

/// The binding of a visitor to one arm of one experiment. Created once and never changed,
/// which is what makes a visitor's experience consistent across visits.
model Assignment {
  id           String   @id @default(cuid())
  experimentId String
  visitorId    String
  /// NULL means the control arm. Non-null references the specific variant the visitor was
  /// redirected to.
  variantId    String?
  assignedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  experiment  Experiment         @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  visitor     Visitor            @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  variant     ExperimentVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  events      Event[]
  conversions Conversion[]

  /// Assignment consistency: a visitor can never hold two arms of the same experiment.
  /// Ingestion relies on this to make repeated assignment reports idempotent.
  @@unique([experimentId, visitorId])
  /// Visitor counts and conversion rates group by arm on this index alone.
  @@index([experimentId, variantId])
  @@index([experimentId, assignedAt])
  @@index([visitorId])
  @@map("assignments")
}

/// Append-only activity log. Every row is written in the context of an assignment, so any
/// event can be attributed to an arm without a join.
model Event {
  id           String    @id @default(cuid())
  websiteId    String
  experimentId String
  visitorId    String
  assignmentId String
  /// NULL means the control arm; mirrors `Assignment.variantId` — see that field's comment.
  variantId    String?
  type         EventType
  /// URL the event occurred on, normalised by the ingestion endpoint.
  url          String
  /// Foreground milliseconds. Set on `time_on_page` events only.
  durationMs   Int?
  /// Client clock, clamped server-side to a sane window.
  occurredAt   DateTime
  createdAt    DateTime  @default(now())

  website    Website            @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  experiment Experiment         @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  visitor    Visitor            @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  assignment Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  variant    ExperimentVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// The dashboard's main aggregation path: per-experiment metrics by arm over a date range.
  @@index([experimentId, type, variantId, occurredAt])
  /// Time-series charts for one experiment.
  @@index([experimentId, occurredAt])
  /// Website-wide activity and retention/pruning sweeps.
  @@index([websiteId, createdAt])
  @@index([assignmentId])
  @@index([visitorId])
  @@map("events")
}

/// A completed conversion goal. Kept separate from Event so conversion rate is a row count
/// against a uniquely constrained table rather than a filtered scan with de-duplication.
model Conversion {
  id           String   @id @default(cuid())
  experimentId String
  visitorId    String
  assignmentId String
  /// NULL means the control arm; mirrors `Assignment.variantId` — see that field's comment.
  variantId    String?
  /// URL that satisfied the goal.
  url          String
  occurredAt   DateTime
  createdAt    DateTime @default(now())

  experiment Experiment         @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  visitor    Visitor            @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  assignment Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  variant    ExperimentVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// Conversion idempotency: one conversion per assignment. A visitor reloading the
  /// thank-you page, or a duplicate beacon, cannot inflate the conversion count. The MVP has
  /// a single goal per experiment, so assignment identity is the whole key; a multi-goal
  /// model would extend this to [assignmentId, goalId].
  @@unique([assignmentId])
  /// Conversion counts group by arm on this index alone.
  @@index([experimentId, variantId])
  @@index([experimentId, occurredAt])
  @@index([visitorId])
  @@map("conversions")
}

// ---------------------------------------------------------------------------
// Integrations
// ---------------------------------------------------------------------------

/// State of a customer's Google connection.
///
/// There is deliberately no DISCONNECTED member: disconnecting revokes the token at Google and
/// deletes the row, so "not connected" is the absence of a row rather than a state that could
/// drift out of step with what Google believes.
enum SheetsConnectionStatus {
  CONNECTED

  /// Google refused the refresh token — revoked by the customer at
  /// myaccount.google.com/permissions, expired after six months unused, or expired after seven
  /// days because the OAuth app's publishing status is still "Testing". The daily sweep skips
  /// the connection and the UI asks for a reconnect. Never a silent failure.
  NEEDS_RECONNECT
}

/// One Google authorisation per workspace.
///
/// This row is the *grant*, not the destination. The customer authorises Google once; each of
/// their websites then points at its own spreadsheet (see WebsiteSheetTarget). Splitting the two
/// is what lets a website be given a sheet without another consent screen — and Google caps
/// refresh tokens at roughly 100 per account per client, so a grant per website would eventually
/// start silently invalidating the oldest.
///
/// Deliberately **not** the Auth.js `Account` row. Adding Sheets and Drive scopes to the sign-in
/// provider would force every customer to grant Drive access merely to log in, and `Account`'s
/// @@unique([provider, providerAccountId]) means a re-consent would collide with the adapter's
/// own row. Nothing the adapter owns is touched by this model.
model SheetsConnection {
  id String @id @default(cuid())

  /// One connection per workspace. Replaced `userId`; existing rows moved to the connecting
  /// user's workspace.
  workspaceId String @unique

  /// The member who connected it. Only they may open the Google Picker, because the Picker runs
  /// on this grant's access token — another member would be browsing someone else's Drive.
  connectedById String?

  /// Google profile name and picture of the granting account, for display.
  googleName    String?
  googlePicture String?

  /// Google account that granted access. Display only, so the customer can confirm they
  /// connected the account they meant to.
  googleEmail String?

  /// Google's opaque subject id, which survives the customer changing their email address.
  googleSubject String?

  /// AES-256-GCM ciphertext of the OAuth refresh token — see src/server/crypto.ts.
  ///
  /// This is the one value in this database that grants ongoing access to something outside
  /// Routely, so it is the one value encrypted at rest. The column is named for what it holds,
  /// not for what it represents. Never logged, never returned to a client.
  refreshTokenCipher String @db.Text

  /// Short-lived access token, cached so one page interaction does not refresh three times.
  /// Encrypted the same way: shorter-lived is not the same as harmless.
  accessTokenCipher    String?   @db.Text
  accessTokenExpiresAt DateTime?

  /// Scopes Google actually granted, space-separated — which is not necessarily what was asked
  /// for. Granular consent lets the customer untick individual scopes, so the UI reads this
  /// rather than assuming, and falls back to a pasted spreadsheet URL when Drive was declined.
  grantedScopes String

  status SheetsConnectionStatus @default(CONNECTED)

  /// Why it stopped working, in words meant for the customer. Null while CONNECTED.
  statusDetail String?

  connectedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedBy User?     @relation("SheetsConnectedBy", fields: [connectedById], references: [id], onDelete: SetNull)

  @@map("sheets_connections")
}

/// Where one website's results are published, and the state of the tab holding them.
///
/// Per website, not per account: someone running several sites — an agency especially — wants each
/// site's numbers in its own spreadsheet, often one they will hand to a different client. The Google
/// *authorisation* stays per account (see SheetsConnection), so attaching a sheet needs no consent
/// screen of its own.
///
/// A website with no row here is simply not published. That is deliberate: choosing a spreadsheet is
/// optional, so adding a website never depends on Google being reachable.
model WebsiteSheetTarget {
  id String @id @default(cuid())

  /// One destination per website. The uniqueness *is* the "one spreadsheet per website" rule.
  websiteId String @unique

  /// The spreadsheet, as Google's file id.
  ///
  /// Reachable under the `drive.file` scope only because the customer either picked this file in the
  /// Google Picker or Routely created it — the app has no access to anything else in their Drive.
  spreadsheetId String

  /// Spreadsheet name as last read from Google. A display cache, never trusted as input.
  spreadsheetName String?

  /// The tab Routely writes to, by its stable numeric id (`gid`).
  ///
  /// **Routely creates this tab and owns it.** The customer chooses a spreadsheet, not a tab, because
  /// every refresh *overwrites* this tab wholesale — pointing that at a tab holding their own work
  /// would destroy it. Renaming a tab in Sheets changes its title and notifies nobody, so the title
  /// is resolved from the gid before every write and the title below is only a cache.
  sheetId    Int
  sheetTitle String

  /// How many rows the tab last held, so a refresh can blank the difference when the row count
  /// shrinks. Without it, an experiment being deleted would leave its stale rows on display.
  rowCount Int @default(0)

  /// When the tab was last written. This is the throttle: a refresh is claimed by a compare-and-set
  /// against this column, so however much traffic arrives, the tab is rewritten at most once per
  /// interval per website — which keeps a busy site inside Google's write quota of 60 per minute per
  /// user.
  refreshedAt DateTime?

  /// Why the last refresh failed, in the customer's words. Null when the last one succeeded.
  lastError String?

  /// Latch for the "Google Sheets sync fails" email, so one failure streak sends one email.
  errorNotifiedAt DateTime?

  /// True when Routely created the spreadsheet rather than the customer picking an existing one.
  /// Only used to word the UI honestly.
  createdByRoutely Boolean @default(false)

  attachedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@map("website_sheet_targets")
}
